# .env.example - Bu dosyayı .env olarak kopyalayıp kendi değerlerinle doldur
COMPOSE_PROJECT_NAME=cozy_book_tracker

# MongoDB
MONGO_INITDB_ROOT_USERNAME=your_admin_username
MONGO_INITDB_ROOT_PASSWORD=your_secure_password
MONGO_PORT=27017
MONGO_DB_NAME=cozy_books

# Backend
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=5173 